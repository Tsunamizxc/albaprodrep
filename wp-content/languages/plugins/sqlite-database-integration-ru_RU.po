msgstr "База данных: MariaDB"

#: admin-page.php:142
msgid "Database: SQLite"
msgstr "База данных: SQLite"

#: wp-includes/sqlite/install-functions.php:163
msgid "The password you chose during installation."
msgstr "Пароль, выбранный вами при установке."

